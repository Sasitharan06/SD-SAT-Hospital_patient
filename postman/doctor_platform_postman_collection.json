        {
          "name": "Search Doctors by Specialty",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/doctors?specialty=Cardiology",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "doctors"],
              "query": [
                { "key": "specialty", "value": "Cardiology" }
