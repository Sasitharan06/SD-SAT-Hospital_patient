    {
      "name": "5. Prescription Service (Port 3004 via Gateway)",
      "item": [
        {
          "name": "Issue Digital Prescription (Doctor Role)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Role", "value": "DOCTOR" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointment_id\": \"apt-301\",\n  \"doctor_id\": \"doc-201\",\n  \"patient_id\": \"pat-101\",\n  \"diagnosis\": \"Mild sinus tachycardia & essential hypertension\",\n  \"notes\": \"Follow low-sodium diet and repeat lipid profile in 4 weeks.\",\n  \"medicines\": [\n    {\n      \"medicine_name\": \"Metoprolol Tartrate 25mg\",\n      \"dosage\": \"25 mg\",\n      \"frequency\": \"Twice daily\",\n      \"duration\": \"14 days\",\n      \"instructions\": \"Take after meals with warm water.\"\n    },\n    {\n      \"medicine_name\": \"Atorvastatin Calcium 10mg\",\n      \"dosage\": \"10 mg\",\n      \"frequency\": \"Once daily at bedtime\",\n      \"duration\": \"30 days\",\n      \"instructions\": \"Take at night.\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/prescriptions",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "prescriptions"]
            }
          }
        },
