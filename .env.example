# ==========================================================
# Online Doctor Appointment Platform - Environment Configuration
# ==========================================================

# API Gateway Configuration
GATEWAY_PORT=3000
NODE_ENV=development

# Microservices URLs (internal or proxy targets)
PATIENT_SERVICE_URL=http://localhost:3001
DOCTOR_SERVICE_URL=http://localhost:3002
APPOINTMENT_SERVICE_URL=http://localhost:3003
PRESCRIPTION_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005

# PostgreSQL Connection (Optional: if not configured, system runs in Demo Fallback Mode)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=doctor_platform
DATABASE_URL=postgres://postgres:postgres@localhost:5432/doctor_platform

# Redis Caching (Optional: falls back to in-memory TTL cache)
REDIS_URL=redis://localhost:6379

# RabbitMQ Message Queue (Optional: falls back to local async EventBus)
RABBITMQ_URL=amqp://localhost:5672
